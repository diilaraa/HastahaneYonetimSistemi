@model IEnumerable<ProjeYonetim.Models.AcilDurum>

<h2>Acil Durumlar</h2>

<div>
    <a href="@Url.Action("Ekle", "AcilDurum")" class="btn btn-primary">Yeni Acil Durum Ekle</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Başlık</th>
            <th>Açıklama</th>
            <th>Tarih</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Baslik</td>
                <td>@item.Aciklama</td>
                <td>@item.Tarih.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>
                    <!-- Düzenle Butonu -->
                    <a href="@Url.Action("Duzenle", "AcilDurum", new { id = item.AcilDurumId })" class="btn btn-warning">Düzenle</a>

                    <a href="@Url.Action("Sil", "AcilDurum", new { id = item.AcilDurumId })" class="btn btn-danger" onclick="return confirm('Bu acil durumu silmek istediğinize emin misiniz?')">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>
