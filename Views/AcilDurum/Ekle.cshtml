@model ProjeYonetim.Models.AcilDurum

<h2>Yeni Acil Durum Ekle</h2>

@using (Html.BeginForm("Ekle", "AcilDurum", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        @Html.LabelFor(model => model.Baslik)
        @Html.TextBoxFor(model => model.Baslik, new { @class = "form-control", @placeholder = "Acil Durum Başlığını Girin" })
        @Html.ValidationMessageFor(model => model.Baslik)
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.Aciklama)
        @Html.TextAreaFor(model => model.Aciklama, new { @class = "form-control", @rows = "4", @placeholder = "Acil Durum Açıklamasını Girin" })
        @Html.ValidationMessageFor(model => model.Aciklama)
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a href="@Url.Action("Index", "AcilDurum")" class="btn btn-default">İptal</a>
    </div>
}
