@model ProjeYonetim.Models.Asistan


<head>
    <meta name="viewport" content="width=device-width" />
    <title>Asistan Düzenleme</title>

    <!-- Style Section -->
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f7fc;
            margin: 0;
            padding: 0;
        }

        #container {
            max-width: 800px;
            margin: 30px auto;
            background-color: #fff;
            border-radius: 8px;
            padding: 30px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }

        h3 {
            font-size: 24px;
            color: #333;
            text-align: center;
            margin-bottom: 20px;
        }

        .input-group {
            margin-bottom: 20px;
        }

        .input-group-prepend {
            width: 90%;
        }

        .input-group-text {
            font-weight: bold;
            color: #333;
            background-color: #f7f7f7;
            border: 1px solid #ccc;
            border-radius: 4px 0 0 4px;
        }

        .form-control {
            border: 1px solid #ccc;
            border-radius: 4px;
            padding: 10px;
            font-size: 14px;
            width: 100%;
        }

            .form-control:focus {
                border-color: #66afe9;
                box-shadow: 0 0 5px rgba(102, 175, 233, 0.6);
            }

        .btn {
            padding: 12px 20px;
            font-size: 16px;
            text-align: center;
            border-radius: 4px;
            border: none;
            cursor: pointer;
            display: block;
            width: 100%;
        }

        .btn-success {
            background-color: #28a745;
            color: #fff;
            font-weight: bold;
        }

            .btn-success:hover {
                background-color: #218838;
            }

        .alert {
            border-radius: 4px;
            padding: 10px 20px;
            margin-top: 10px;
        }

        .alert-success {
            background-color: #d4edda;
            color: #155724;
            border-color: #c3e6cb;
        }

        .alert-danger {
            background-color: #f8d7da;
            color: #721c24;
            border-color: #f5c6cb;
        }

        .input-group label {
            font-size: 14px;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div id="container" class="container mt-5">
        <h3 class="text-center mb-4">Asistan Düzenleme</h3>

        @using (Html.BeginForm())
        {
            @Html.HiddenFor(x => x.AsistanID) <!-- Add hidden input for ID -->

            <div class="input-group m-5">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="txtad">Ad</span>
                    @Html.TextBoxFor(x => x.Ad, new { @class = "form-control", placeholder = "Adınız", aria_label = "Ad", aria_describedby = "txtad" })
                </div>
            </div>

            <div class="input-group m-5">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="txtsoyad">Soyad</span>
                    @Html.TextBoxFor(x => x.Soyad, new { @class = "form-control", placeholder = "Soyadınız", aria_label = "Soyad", aria_describedby = "txtsoyad" })
                </div>
            </div>

            <div class="input-group m-5">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="txtmail">Mail</span>
                    @Html.TextBoxFor(x => x.Mail, new { @class = "form-control", placeholder = "Mail adresiniz", aria_label = "Mail", aria_describedby = "txtmail" })
                </div>
            </div>

            <div class="input-group m-5">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="txttelefon">Telefon</span>
                    @Html.TextBoxFor(x => x.Telefon, new { @class = "form-control", placeholder = "Telefon numaranız", aria_label = "Telefon", aria_describedby = "txttelefon" })
                </div>
            </div>

            <div class="input-group m-5">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="ddlbbolum">Bölüm</span>
                    @Html.DropDownListFor(x => x.BolumId, ViewBag.Bolumler as IEnumerable<SelectListItem>, new { @class = "form-control", aria_describedby = "ddlbbolum" })
                </div>
            </div>

            <div class="input-group m-5">
                <input type="submit" value="Güncelle" class="btn btn-primary btn-block" />
            </div>
            <br />
            <div class="input-group">
                @if (ViewBag.Result != null)
                {
                    <div class="alert alert-@ViewBag.Status m-5" role="alert">
                        @ViewBag.Result
                    </div>
                }
            </div>
        }
    </div>S
</body>

