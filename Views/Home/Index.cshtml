@{
    ViewBag.Title = "Home Page";
}

<main>

    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <h2 class="display-4">Pediatri Yönetim Sistemi</h2>
            <p class="lead">Güncel nöbet bilgileri, randevu takibi ve acil durumlar için dijital çözüm.</p>
            <div>
                <a href="#" class="btn btn-primary btn-lg mx-2">Randevu Al</a>
                <a href="#" class="btn btn-outline-primary btn-lg mx-2">Nöbet Listesi</a>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="features py-5">
        <div class="container text-center">
            <div class="row">
                <div class="col-md-4">
                    <div class="image-box">
                        <img src="~/Images/acil.jpeg" alt="Çocuk Acil">
                    </div>
                    <h3>
                        <a href="Bolumler#acil">Çocuk Acil</a>
                    </h3>
                    <p>Hızlı müdahale ve tedavi için uzman ekipler.</p>
                </div>
                <div class="col-md-4">
                    <div class="image-box">
                        <img src="~/Images/bakim.jpeg" alt="Yoğun Bakım">
                    </div>
                    <h3>
                        <a href="Bolumler#bakim">Yoğun Bakım</a>
                    </h3>
                    <p>Kesintisiz bakım ve yenilikçi çözümler.</p>
                </div>
                <div class="col-md-4">
                    <div class="image-box">
                        <img src="~/Images/hemo.jpeg" alt="Hematoloji">
                    </div>
                    <h3>
                        <a href="Bolumler#hemo">Hematoloji ve Onkoloji</a>
                    </h3>
                    <p>Hasta ve aile dostu uzmanlık hizmetleri.</p>
                </div>
            </div>
        </div>
    </section>



</main>