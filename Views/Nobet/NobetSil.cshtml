@model ProjeYonetim.Models.Nobet

@{
    ViewBag.Title = "Nöbet Sil";
}

<h2>Nöbeti Sil</h2>
<h3>@Model.Tarih.ToString("yyyy-MM-dd") tarihli nöbeti silmek istediğinize emin misiniz?</h3>

@using (Html.BeginForm("Delete", "Nobet", new { id = Model.NobetId }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Evet, Sil</button>
    <a href="@Url.Action("NobetListele", "Nobet")" class="btn btn-primary">İptal</a>
}
