<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pediatri Nöbet Yönetimi</title>
    <!-- Bootstrap CSS -->
    <link href="~/Content/Site.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    @RenderSection("Styles", required: false)
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

</head>

<body>
    <!-- Header -->
    <header>
        <div class="container d-flex justify-content-between align-items-center">
            <div class="logo">
                <img src="/Images/stetlogo.jpeg" alt="Pediatri Yönetim Sistemi Logosu">

            </div>

            <nav>
                <ul class="nav">
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Home")" class="nav-link">Anasayfa</a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("OgrUye", "OgrUye")" class="nav-link">Öğretim Üyeleri</a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Asistan", "Asistan")" class="nav-link">Asistanlar</a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Bolumler", "Bolum")" class="nav-link">Bölümler</a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("NobetTakvim", "Nobet")" class="nav-link">Nöbet Takvimi</a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("RandevuAl", "Randevu")" class="nav-link">Randevu</a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("AcilDurum", "AcilDurum")" class="nav-link">Acil Durumlar</a>
                    </li>
                </ul>
            </nav>

            <!-- Login Button -->
            <div>
                <a href="/Account/Login" class="btn btn-primary">Giriş Yap</a>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <div class="container mt-4">
        @RenderBody() <!-- Burada içerik yer alacak -->
        @RenderSection("Scripts", required: false)
        
    </div>

    <!-- Footer -->
    <footer>
        <div class="container text-center">
            <p>© 2024 Pediatri Bölümü - Tüm Hakları Saklıdır.</p>
            <p>İletişim: <a href="mailto:dilaratop02@gmail.com" class="text-white">dilaratop02@gmail.com</a></p>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
